# Konfiguration des OneDrive-Clients (abraunegg/onedrive) im Sidecar "sharepoint" des Hermes-Pods:
# eine SharePoint-Dokumentbibliothek. Gleicher Client, gleiche App wie onedrive.config, aber eigener Login
# (eigenes conf/ mit Token und Sync-DB) und eigener Mount bei Hermes (/opt/sharepoint).
# Landet als Key sharepoint.config in der ConfigMap m365-sync; der Sidecar kopiert ihn beim Start nach
# /onedrive/conf/config. Optionen: siehe onedrive.config (dort kommentiert), Doku 4e "SharePoint/OneDrive".
#
# Achtung Flux: kein "$" gefolgt von "{" in dieser Datei (postBuild-envsubst, strict).

# --- Eigene App-Registrierung in Entra ID (dieselbe wie in onedrive.config) ---
application_id = "08d2c8df-9de2-4ddb-8328-eed94f794100"
azure_tenant_id = "7804793a-7aea-4b72-af44-80d502e33d8d"
use_device_auth = "true"

# --- Die Bibliothek ---
# Pflicht fuer diesen Sidecar. Ermitteln nach dem ersten Login (das Konto muss die Site sehen koennen):
#   kubectl --context karibik -n hermes exec deploy/hermes -c sharepoint -- \
#     onedrive --confdir /onedrive/conf --get-sharepoint-drive-id '<Site-Name>'
# Solange hier REPLACE_ME steht, synchronisiert der Client das OneDrive des Kontos ein zweites Mal –
# deshalb erst eintragen, dann den Sidecar laufen lassen (Rezept in der Doku, Schritt 5).
drive_id = "REPLACE_ME"

skip_dotfiles = "true"
skip_file = "~*|.~*|*.tmp|*.swp|*.partial"

# SharePoint "bereichert" Office-Dateien nach dem Upload (Metadaten) – ohne diese Option Download-Schleife.
disable_upload_validation = "true"

monitor_interval = "300"
monitor_fullscan_frequency = "12"

sync_dir_permissions = "700"
sync_file_permissions = "600"
