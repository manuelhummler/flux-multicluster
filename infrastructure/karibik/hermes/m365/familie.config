# Konfiguration des OneDrive-Clients (abraunegg/onedrive) im Sidecar "familie" des Hermes-Pods:
# SharePoint-Site "Familie" (https://its2morrow.sharepoint.com/sites/familie), Bibliothek "Dokumente".
# Gleicher Client, gleiche App wie onedrive.config, aber eigener Login (eigenes conf/ mit Token und Sync-DB)
# und eigener Mount bei Hermes (/opt/sharepoint/familie). Landet als Key familie.config in der ConfigMap
# m365-sync; der Sidecar kopiert ihn beim Start nach /onedrive/conf/config.
# Optionen: siehe onedrive.config (dort kommentiert), Doku 4e "SharePoint/OneDrive".
#
# Achtung Flux: kein "$" gefolgt von "{" in dieser Datei (postBuild-envsubst, strict).

# --- Eigene App-Registrierung in Entra ID (dieselbe wie in onedrive.config) ---
application_id = "08d2c8df-9de2-4ddb-8328-eed94f794100"
azure_tenant_id = "7804793a-7aea-4b72-af44-80d502e33d8d"
use_device_auth = "true"

# --- Die Bibliothek ---
# Graph: /sites/its2morrow.sharepoint.com:/sites/familie:/drives -> "Dokumente" (ermittelt 2026-11-18).
# Die Site fehlte in der Graph-Site-Suche (search=*), obwohl der Nutzer Besitzer ist – Suchindex, nicht
# Berechtigung; per Pfad ist sie lesbar.
# Aenderung hier verlangt einmalig ONEDRIVE_RESYNC=1 am Sidecar.
drive_id = "b!g5C__xH8-ECVks8A44n0Hwrnp8vgXfdNsTBPph0Oyv4H5KhAZlu9RrYAUK5O3L59"

skip_dotfiles = "true"
skip_file = "~*|.~*|*.tmp|*.swp|*.partial"

# SharePoint "bereichert" Office-Dateien nach dem Upload (Metadaten) – ohne diese Option Download-Schleife.
disable_upload_validation = "true"

monitor_interval = "300"
monitor_fullscan_frequency = "12"

sync_dir_permissions = "700"
sync_file_permissions = "600"
