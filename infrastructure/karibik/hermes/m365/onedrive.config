# Konfiguration des OneDrive-Clients (abraunegg/onedrive) im Sidecar "onedrive" des Hermes-Pods:
# das OneDrive des angemeldeten Kontos. Die SharePoint-Bibliothek hat einen eigenen Sidecar mit eigener
# Datei (sharepoint.config). Landet als Key onedrive.config in der ConfigMap m365-sync; der Sidecar kopiert
# ihn beim Start nach /onedrive/conf/config.
# Referenz: https://github.com/abraunegg/onedrive/blob/master/docs/application-config-options.md
# Doku: docs/clusters/gitops-karibik.md, Abschnitt 4e "SharePoint/OneDrive".
#
# Achtung Flux: kein "$" gefolgt von "{" in dieser Datei (postBuild-envsubst, strict).
# Nach Aenderungen an drive_id oder sync_list verlangt der Client einen --resync:
# einmalig ONEDRIVE_RESYNC=1 am jeweiligen Sidecar setzen (Rezept in der Doku).

# --- Eigene App-Registrierung in Entra ID (Public Client, Device-Code-Flow erlaubt) ---
# Application (client) ID und Directory (tenant) ID aus dem Entra-Portal. Keine Secrets: ein Public
# Client hat kein Client-Secret, die Tenant-ID steht in jeder Login-URL.
application_id = "08d2c8df-9de2-4ddb-8328-eed94f794100"
azure_tenant_id = "7804793a-7aea-4b72-af44-80d502e33d8d"

# Device-Code-Login statt Browser-Redirect: der Sidecar druckt URL + Code ins Log, Anmeldung auf einem
# beliebigen Geraet, ca. 15 Minuten gueltig. Nur fuer Entra-ID-Konten (Work/School), nicht fuer
# persoenliche Microsoft-Konten.
use_device_auth = "true"

# --- Was synchronisiert wird ---
# Keine drive_id = das OneDrive des angemeldeten Kontos (komplett; Teilsynchronisation per sync_list,
# siehe Doku). SharePoint-Bibliotheken laufen ueber den Sidecar "sharepoint" (sharepoint.config, drive_id).

# Dotfiles (.git, .cache, Editor-Reste des Agenten) bleiben lokal.
skip_dotfiles = "true"
# Standard-Ausschluss des Clients (temporaere und Partial-Dateien); eigener Wert ersetzt die Vorgabe komplett.
skip_file = "~*|.~*|*.tmp|*.swp|*.partial"

# --- SharePoint-Eigenheit ---
# SharePoint "bereichert" Office-Dateien nach dem Upload mit Metadaten; Groesse und Hash stimmen danach
# nicht mehr mit der lokalen Datei ueberein, der Client wuerde sie als geaendert erneut herunterladen.
# Deshalb Upload-Validierung aus (laut Client-Doku die empfohlene Einstellung fuer SharePoint).
disable_upload_validation = "true"

# --- Monitor-Modus ---
# Lokale Aenderungen kommen sofort per inotify; Online-Aenderungen holt der Client alle 300 s (Minimum),
# ein vollstaendiger Online-Abgleich alle 12 Zyklen (= stuendlich).
monitor_interval = "300"
monitor_fullscan_frequency = "12"

# Dateirechte im Spiegel: Hermes laeuft als dieselbe UID (10000), 700/600 reichen.
sync_dir_permissions = "700"
sync_file_permissions = "600"
