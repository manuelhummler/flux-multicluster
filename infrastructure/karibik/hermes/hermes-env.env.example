# Vorlage – echte Werte nur in hermes-env-encrypted.env (verschluesselt).
# Hermes Agent – Secrets fuer karibik (SOPS, Regel aus ../.sops.yaml).
# Bearbeiten (entschluesselt im Editor, verschluesselt beim Speichern):
#   sops infrastructure/karibik/hermes/hermes-env-encrypted.env
# Alle Keys landen 1:1 als Umgebungsvariablen im Hermes-Pod (Secret hermes-secrets, extraEnvFrom).

# --- LLM-Provider: OpenAI Codex per ChatGPT-Abo (OAuth-Device-Login beim Pod-Start, kein API-Key) ---
# Der Login laeuft ueber den Init-Container auth-device-login (Doku 4e). Fuer den Provider openai-api
# stattdessen hier OPENAI_API_KEY=sk-... eintragen und im HelmRelease provider/model umstellen.

# --- Dashboard-Login (Basic-Auth, bis OIDC via Keycloak kommt) ---
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hummli
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=<zufaelliges-passwort>
# Session-Signing-Secret (zufaellig, bleibt stabil ueber Pod-Neustarts)
HERMES_DASHBOARD_BASIC_AUTH_SECRET=<openssl rand -base64 32>

# --- Telegram-Gateway (Anleitung: docs/clusters/gitops-karibik.md, Abschnitt 4e) ---
# Bot-Token von @BotFather, Format 123456789:AAxxxxxxxx
TELEGRAM_BOT_TOKEN=REPLACE_ME
# Deine numerische Telegram-User-ID (von @userinfobot), mehrere kommagetrennt. Ohne Eintrag antwortet der Bot niemandem.
TELEGRAM_ALLOWED_USERS=REPLACE_ME
# Chat-ID fuer Zustellungen des Agenten: Device-Code beim Codex-Login, "Gateway laeuft"-Meldung, Cron-Ausgaben.
# Fuer 1:1 = deine User-ID. Der Bot kann dir erst schreiben, nachdem du ihm einmal /start geschickt hast!
TELEGRAM_HOME_CHANNEL=REPLACE_ME
