# Vorlage – echte Werte nur in renovate-gitlab-env-encrypted.env (verschluesselt).
# Renovate (GitLab-Instanz) – Secrets fuer karibik (SOPS, Regel aus ../.sops.yaml).
# Bearbeiten (entschluesselt im Editor, verschluesselt beim Speichern):
#   sops infrastructure/karibik/renovate/renovate-gitlab-env-encrypted.env
# Alle Keys landen 1:1 als Umgebungsvariablen im Renovate-Pod (Secret renovate-gitlab-env, envFrom).

# GitLab Personal Access Token mit Scopes api, read_user, write_repository (Doku 4f)
RENOVATE_TOKEN=glpat-REPLACE_ME
# Lesender GitHub-Token (fine-grained, "Public repositories (read-only)") fuer Changelogs und
# github-releases-Lookups; leer lassen = anonymes Rate-Limit
GITHUB_COM_TOKEN=REPLACE_ME
