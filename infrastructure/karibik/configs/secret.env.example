# Vorlage für cluster-secrets (karibik) – OHNE echte Geheimnisse committen!
#
# Nutzung:
#   1. cp secret.env.example secret-encrypted.env
#   2. Werte eintragen (Platzhalter <...> ersetzen)
#   3. Verschlüsseln:  sops --encrypt --in-place secret-encrypted.env
#      (nutzt die age-Regel aus ../.sops.yaml – aus infrastructure/karibik/ ausführen)
#   4. Nur die verschlüsselte secret-encrypted.env committen.
#
# Diese Datei (.example) enthält bewusst KEINE echten Werte und wird mitversioniert.
# ---------------------------------------------------------------------------

# Basis-Domain des Clusters. Ingress-Hosts wie longhorn.${DOMAIN} / hubble.${DOMAIN}.
DOMAIN=<basis-domain>
# Weitere App-Domains (siehe captain-kube-Apps).
DOMAIN_2=<domain-2>
DOMAIN_3=<domain-3>
DOMAIN_4=<domain-4>
# Host des oauth2-proxy (Phase 2).
OAUTH_PROXY_DOMAIN=<auth-proxy-host>
# E-Mail für die Let's-Encrypt-ACME-Registrierung (cluster-issuer).
EMAIL=<acme-email>
# Hermes Agent (KI-Harness): eigener Host ausserhalb von ${DOMAIN}, z. B. hermes.hummler.com
HERMES_DOMAIN=<hermes-host>

# Control-Plane-Endpoint / LB (karibik, "fontaene-der-jugend").
# API_SERVER_IP MUSS dem controlPlaneEndpoint entsprechen, mit dem kubeadm aufgesetzt hat.
LB_IP=<lb-ip>
API_SERVER_IP=<api-server-ip>
API_SERVER_PORT=<api-server-port>
