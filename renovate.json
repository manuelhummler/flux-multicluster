{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "branchConcurrentLimit": 20,
  "flux": {
    "managerFilePatterns": [
      "/infrastructure/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/infrastructure/.+\\.yaml$/"
    ]
  },
  "hostRules": [
    {
      "hostType": "docker",
      "matchHost": "ghcr.io",
      "username": "blackwolfk-9",
      "password": "{{ secrets.GHCR_TOKEN }}"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/open-project-e-v/fest-der-demokratie"],
      "versioning": "numeric",
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "prPriority": 10
    },
    {
      "description": "captain-kube Bitnami charts (minio 15.0.7, keycloak 24.7.7) pinned to the installed releases: newer Bitnami charts reference images moved to bitnamilegacy (not pullable); cluster is being decommissioned",
      "matchFileNames": ["infrastructure/base/apps/minio/**", "infrastructure/base/apps/keycloak/**"],
      "enabled": false
    }
  ]
}
